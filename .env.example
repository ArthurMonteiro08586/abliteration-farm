# captcha chain order (solvers.py)
CAPTCHA_BACKENDS=sidecar-realpage,2captcha,yescaptcha,capmonster,anticaptcha

# FREE local solver: github.com/waguriagentic/captcha-solver
SIDECAR_URL=http://127.0.0.1:8877

# paid fallbacks (optional)
TWOCAPTCHA_KEY=
YESCAPTCHA_KEY=
CAPMONSTER_KEY=
ANTICAPTCHA_KEY=

# ProxyGrab API (optional; put real key in .proxygrab.json instead)
PROXYGRAB_N=8
PROXYGRAB_PROTO=http
PROXYGRAB_TEST=abliteration.ai
USE_PROXYGRAB=1

# gateway
ABLIT_GW_PORT=8300
GATEWAY_API_KEY=
