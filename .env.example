# paid fallbacks (optional)
TWOCAPTCHA_KEY=
YESCAP…KEY=
CAPMONSTER_KEY=
ANTICAPTCHA_KEY=

*** proxy file (default: proxies.txt / proxies_good.txt)
PROXY_FILE=

# gateway
ABLIT_GW_PORT=8300
GATEWAY_API_KEY=***
